
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-brain",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-memory",
      "database_id": "a040f16b-f1e5-4798-837d-25f7cdb664aa"
    }
  ],
  "upload_source_maps": true
}
